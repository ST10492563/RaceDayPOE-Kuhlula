@model RaceDayMvc.Models.ResultViewModel

@{
    ViewData["Title"] = "Event Results";
    var eventItem = ViewBag.Event as RaceDayMvc.Models.EventViewModel;
    var enrollments = ViewBag.Enrollments as List<RaceDayMvc.Models.EnrollmentViewModel>
                      ?? new List<RaceDayMvc.Models.EnrollmentViewModel>();
    var results = ViewBag.Results as List<RaceDayMvc.Models.ResultViewModel>
                  ?? new List<RaceDayMvc.Models.ResultViewModel>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Event Results</h2>

            @if (eventItem != null)
            {
                <p class="text-muted mb-0">
                    @eventItem.EventName
                </p>
            }
        </div>

        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Add Race Result</h5>

            @if (enrollments.Any())
            {
                <form asp-controller="Organiser"
                      asp-action="AddResult"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="eventId"
                           value="@eventItem?.EventID" />

                    <div class="mb-3">
                        <label asp-for="EnrollmentID"
                               class="form-label">
                            Participant
                        </label>

                        <select asp-for="EnrollmentID"
                                class="form-select"
                                required>

                            <option value="">Select participant</option>

                            @foreach (var enrollment in enrollments)
                            {
                                <option value="@enrollment.EnrollmentID">
                                    Enrollment #@enrollment.EnrollmentID
                                    - Participant ID: @enrollment.ParticipantID
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FinishTime"
                               class="form-label">
                            Finish Time
                        </label>

                        <input asp-for="FinishTime"
                               type="time"
                               step="1"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Position"
                               class="form-label">
                            Finishing Position
                        </label>

                        <input asp-for="Position"
                               type="number"
                               min="1"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AveragePace"
                               class="form-label">
                            Average Pace
                        </label>

                        <input asp-for="AveragePace"
                               class="form-control"
                               placeholder="Example: 5:30 min/km" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ResultStatus"
                               class="form-label">
                            Result Status
                        </label>

                        <select asp-for="ResultStatus"
                                class="form-select">
                            <option value="Finished">Finished</option>
                            <option value="DNF">Did Not Finish</option>
                            <option value="Disqualified">Disqualified</option>
                        </select>
                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Save Result
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No participants are currently enrolled in this event.
                </div>
            }

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Recorded Results</h5>

            @if (!results.Any())
            {
                <div class="alert alert-info">
                    No results have been recorded for this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Enrollment</th>
                                <th>Position</th>
                                <th>Finish Time</th>
                                <th>Average Pace</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var result in results)
                            {
                                <tr>
                                    <td>@result.EnrollmentID</td>
                                    <td>@(result.Position?.ToString() ?? "-")</td>
                                    <td>
                                        @(result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "-")
                                    </td>
                                    <td>@(result.AveragePace ?? "-")</td>
                                    <td>@result.ResultStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>


