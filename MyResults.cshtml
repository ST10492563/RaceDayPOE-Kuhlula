@model List<RaceDayMvc.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<h2>My Race Results</h2>

@if (ViewBag.IsDemo == true)
{
    <div class="alert alert-warning">
        <strong>Demonstration data:</strong>
        These sample results demonstrate the results page.
        They are not official race results.
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No race results are available yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Result ID</th>
                <th>Enrollment ID</th>
                <th>Finish Time</th>
                <th>Position</th>
                <th>Average Pace</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model)
            {
                <tr>
                    <td>@result.ResultID</td>
                    <td>@result.EnrollmentID</td>
                    <td>@(result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "N/A")</td>
                    <td>@(result.Position?.ToString() ?? "N/A")</td>
                    <td>@result.AveragePace</td>
                    <td>@result.ResultStatus</td>
                </tr>
            }
        </tbody>
    </table>
}